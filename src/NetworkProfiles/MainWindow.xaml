<Window x:Class="NetworkProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Profiles" Height="600" Width="1000" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentBrush}" DockPanel.Dock="Left" Margin="0,0,12,0">
        <TextBlock Text="NP" FontSize="16" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="23" FontWeight="SemiBold" Text="Network Profiles"/>
        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}"
                   Text="PLC bağlantıları için IPv4 profillerini yönetin"/>
      </StackPanel>
    </DockPanel>
    <TextBlock Grid.Row="1" Margin="0,14,0,14" Foreground="{StaticResource MutedTextBrush}"
               Text="Profilleri kaydedin, istediğiniz adaptöre uygulayın ve gerektiğinde DHCP'ye dönün."/>
    <TabControl Grid.Row="2">
      <TabItem Header="Profiller">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="ProfilesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                    AlternationCount="2" RowHeaderWidth="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Profil" Binding="{Binding Name}" Width="1.5*"/>
              <DataGridTextColumn Header="Adaptör" Binding="{Binding AdapterName}" Width="2*"/>
              <DataGridTextColumn Header="IPv4 modu" Binding="{Binding Mode}" Width="*"/>
              <DataGridTextColumn Header="IPv4 adresi" Binding="{Binding IPv4Address}" Width="*"/>
              <DataGridTextColumn Header="Ağ geçidi" Binding="{Binding Gateway}" Width="*"/>
              <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="1.5*"/>
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock Text="{Binding ElementName=ProfilesGrid, Path=Items.Count, StringFormat='Kayıtlı profil: {0}'}"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Right">
              <Button Content="Ekle" MinWidth="76" Margin="4,0" Click="AddProfile_Click"/>
              <Button Content="Düzenle" MinWidth="84" Margin="4,0" Click="EditProfile_Click"/>
              <Button Content="Uygula" MinWidth="84" Margin="4,0" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="ApplySelected_Click"/>
              <Button Content="Sil" MinWidth="66" Margin="4,0" Click="DeleteProfile_Click"/>
              <Button Content="İçe aktar" MinWidth="86" Margin="4,0" Click="ImportProfiles_Click"/>
              <Button Content="Dışa aktar" MinWidth="90" Margin="4,0" Click="ExportProfiles_Click"/>
            </WrapPanel>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Ağ adaptörleri">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="AdaptersGrid" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                    RowHeaderWidth="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Adaptör" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="*"/>
              <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*"/>
              <DataGridTextColumn Header="IPv4" Binding="{Binding IPv4}" Width="2*"/>
              <DataGridTextColumn Header="Ağ geçidi" Binding="{Binding Gateway}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}"
                     Text="IPv4 adresi atanmış adaptörler listenin üstünde gösterilir."/>
        </Grid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
      <CheckBox x:Name="StartupCheckBox" Content="Windows ile başlat (tepsiye küçült)" VerticalAlignment="Center"
                Margin="0,0,16,0" DockPanel.Dock="Left" Click="Startup_Changed"/>
      <Button Content="Ağ tarayıcı" Padding="10,5" Margin="0,0,8,0" DockPanel.Dock="Right" Click="OpenScanner_Click"/>
      <Button Content="Yenile" MinWidth="82" Padding="10,5" Margin="0,0,8,0" DockPanel.Dock="Right" Click="Refresh_Click"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                 Text="Ağ ayarları okunuyor..." TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>