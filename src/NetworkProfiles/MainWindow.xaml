<Window x:Class="NetworkProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Network Profiles" Height="660" Width="1120" MinHeight="520" MinWidth="820"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#303644"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#394253"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseTitleBarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource WindowBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" ToolTip="Küçült" Click="MinimizeWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" ToolTip="Büyüt / geri yükle" Click="MaximizeRestoreWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="&#xE8BB;" ToolTip="Kapat" Click="CloseWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
        <TextBlock Text="Network Profiles" Margin="14,0,0,0" VerticalAlignment="Center"
                   FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
      </DockPanel>
    </Border>
  <Grid Grid.Row="1" Margin="16" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl Grid.Row="0" Background="{StaticResource WindowBrush}">
      <TabItem Header="Profiller">
        <Grid Margin="10" Background="{StaticResource SurfaceBrush}">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="ProfileSearchBox" Width="250" ToolTip="Profil adı, IP, ağ geçidi veya DNS ile ara"
                     TextChanged="ProfileSearch_Changed" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="AdapterFilterBox" Width="220" SelectionChanged="AdapterFilter_Changed"
                      ToolTip="Adaptöre göre filtrele" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="GroupByAdapterCheckBox" Content="Adaptöre göre grupla" IsChecked="True"
                      Margin="16,0,0,0" VerticalAlignment="Center" Checked="Grouping_Changed" Unchecked="Grouping_Changed"/>
          </DockPanel>
          <DataGrid x:Name="ProfilesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                    AlternationCount="2" RowHeaderWidth="0"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                    RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="#1D212A"
                    BorderBrush="{StaticResource BorderBrush}">
            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource SurfaceAltBrush}" Padding="8,6" Margin="0,4,0,2" CornerRadius="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Profil" Binding="{Binding Name}" Width="1.4*"/>
              <DataGridTextColumn Header="Durum" Binding="{Binding ActiveStatus}" Width="*"/>
              <DataGridTextColumn Header="Adaptör" Binding="{Binding AdapterName}" Width="1.7*"/>
              <DataGridTextColumn Header="IPv4 modu" Binding="{Binding Mode}" Width="*"/>
              <DataGridTextColumn Header="IPv4 adresi" Binding="{Binding IPv4Address}" Width="*"/>
              <DataGridTextColumn Header="Ağ geçidi" Binding="{Binding Gateway}" Width="*"/>
              <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="1.4*"/>
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="ProfileCountText" Text="Kayıtlı profil: 0" Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Right">
              <Button Content="Ekle" MinWidth="76" Margin="4,0" Click="AddProfile_Click"/>
              <Button Content="Düzenle" MinWidth="84" Margin="4,0" Click="EditProfile_Click"/>
              <Button Content="Uygula" MinWidth="84" Margin="4,0" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="ApplySelected_Click"/>
              <Button Content="Sil" MinWidth="66" Margin="4,0" Click="DeleteProfile_Click"/>
              <Button Content="İçe aktar" MinWidth="86" Margin="4,0" Click="ImportProfiles_Click"/>
              <Button Content="Dışa aktar" MinWidth="90" Margin="4,0" Click="ExportProfiles_Click"/>
            </WrapPanel>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Ağ adaptörleri">
        <Grid Margin="10" Background="{StaticResource SurfaceBrush}">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="AdaptersGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                    RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="#1D212A"
                    BorderBrush="{StaticResource BorderBrush}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Adaptör" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="*"/>
              <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*"/>
              <DataGridTextColumn Header="IPv4" Binding="{Binding IPv4}" Width="2*"/>
              <DataGridTextColumn Header="Ağ geçidi" Binding="{Binding Gateway}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}"
                     Text="IPv4 adresi atanmış adaptörler listenin üstünde gösterilir."/>
        </Grid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="StartupCheckBox" Content="Windows ile başlat" VerticalAlignment="Center"
                  Margin="0,0,16,0" Click="Startup_Changed"/>
        <CheckBox x:Name="SkipApplyConfirmationCheckBox" Content="Uygulama onayını sorma"
                  VerticalAlignment="Center" Margin="0,0,16,0" Click="ApplyConfirmation_Changed"/>
      </StackPanel>
      <Button Content="Ağ tarayıcı" Padding="10,5" Margin="0,0,8,0" DockPanel.Dock="Right" Click="OpenScanner_Click"/>
      <Button Content="Yenile" MinWidth="82" Padding="10,5" Margin="0,0,8,0" DockPanel.Dock="Right" Click="Refresh_Click"/>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Ağ ayarları okunuyor..." TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
  </Grid>
</Window>