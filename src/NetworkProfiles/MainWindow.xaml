<Window x:Class="NetworkProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Profiles" Height="560" Width="900" MinHeight="440" MinWidth="700"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Network Profiles"/>
    <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="Gray"
               Text="PLC bağlantıları için adaptör durumu ve IPv4 profilleri"/>
    <TabControl Grid.Row="2">
      <TabItem Header="Ağ adaptörleri">
        <Grid Margin="8">
          <DataGrid x:Name="AdaptersGrid" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Adaptör" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="*"/>
              <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*"/>
              <DataGridTextColumn Header="IPv4" Binding="{Binding IPv4}" Width="2*"/>
              <DataGridTextColumn Header="Ağ geçidi" Binding="{Binding Gateway}" Width="2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Profiller">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="ProfilesGrid" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Profil" Binding="{Binding Name}" Width="1.5*"/>
              <DataGridTextColumn Header="Adaptör" Binding="{Binding AdapterName}" Width="2*"/>
              <DataGridTextColumn Header="IPv4 modu" Binding="{Binding Mode}" Width="*"/>
              <DataGridTextColumn Header="IPv4 adresi" Binding="{Binding IPv4Address}" Width="*"/>
              <DataGridTextColumn Header="Ağ geçidi" Binding="{Binding Gateway}" Width="*"/>
              <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="1.5*"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Ekle" Width="86" Margin="4,0" Padding="8,5" Click="AddProfile_Click"/>
            <Button Content="Düzenle" Width="86" Margin="4,0" Padding="8,5" Click="EditProfile_Click"/>
            <Button Content="Uygula" Width="86" Margin="4,0" Padding="8,5" Click="ApplySelected_Click"/>
            <Button Content="Sil" Width="70" Margin="4,0" Padding="8,5" Click="DeleteProfile_Click"/>
            <Button Content="İçe aktar" Width="96" Margin="4,0" Padding="8,5" Click="ImportProfiles_Click"/>
            <Button Content="Dışa aktar" Width="96" Margin="4,0" Padding="8,5" Click="ExportProfiles_Click"/>
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Ağ ayarları okunuyor..." TextWrapping="Wrap"/>
      <Button Content="Yenile" Width="100" Padding="10,5" DockPanel.Dock="Right" Click="Refresh_Click"/>
    </DockPanel>
  </Grid>
</Window>