<Window x:Class="NetworkProfiles.QuickIpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick IP" Width="440" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="18" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Apply a temporary IPv4 configuration without saving a profile."
               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <TextBlock Grid.Row="1" Text="Network adapter" Margin="0,0,0,5"/>
    <ComboBox x:Name="AdapterBox" Grid.Row="2" DisplayMemberPath="Name" SelectedValuePath="Id"
              MinHeight="34" Margin="0,0,0,12"/>
    <Grid Grid.Row="3" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="IPv4 address" Margin="0,0,0,5"/>
        <TextBox x:Name="AddressBox" MinHeight="34" Text="192.168.1.10"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Prefix length" Margin="0,0,0,5"/>
        <TextBox x:Name="PrefixBox" MinHeight="34" Text="24"/>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="4" Text="Gateway (optional)" Margin="0,0,0,5"/>
    <TextBox x:Name="GatewayBox" Grid.Row="5" MinHeight="34" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="6">
      <TextBlock Text="DNS servers (optional, comma-separated)" Margin="0,0,0,5"/>
      <TextBox x:Name="DnsBox" MinHeight="34" Margin="0,0,0,16"/>
      <TextBlock Text="This applies immediately. It is not added to your saved profiles."
                 Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" MinWidth="84" Margin="0,0,8,0" IsCancel="True"/>
        <Button Content="Apply" MinWidth="84" IsDefault="True" Click="Apply_Click"
                Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
