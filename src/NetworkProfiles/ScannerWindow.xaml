<Window x:Class="NetworkProfiles.ScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC / Network Scanner" Height="520" Width="720" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="16" Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Local network scanner" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
    <DockPanel Grid.Row="1" Margin="0,12,0,12">
      <TextBlock Text="CIDR" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"/>
      <TextBox x:Name="CidrBox" Width="180" Text="192.168.1.0/24" Padding="6" VerticalContentAlignment="Center"/>
      <Button x:Name="StartButton" Content="Start scan" Margin="10,0,0,0" Padding="12,5" Click="Start_Click"/>
      <Button x:Name="CancelButton" Content="Cancel" Margin="6,0,0,0" Padding="12,5" IsEnabled="False" Click="Cancel_Click"/>
    </DockPanel>
    <DataGrid x:Name="ResultsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
              CanUserAddRows="False" HeadersVisibility="Column"
              Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
              RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="#1D212A"
              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{StaticResource BorderBrush}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="IPv4 address" Binding="{Binding Address}" Width="2*"/>
        <DataGridTextColumn Header="Response (ms)" Binding="{Binding RoundtripTimeMs}" Width="*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                 Text="Scanning starts only when requested. Only private IPv4 networks are scanned, with a maximum of 1,022 addresses."/>
      <Button Content="Export CSV" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="10,5" Click="Export_Click"/>
    </DockPanel>
  </Grid>
</Window>